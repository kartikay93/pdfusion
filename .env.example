# Path to the LibreOffice soffice binary. Leave unset on Linux if `soffice`
# is already on PATH. On Windows this is usually required, e.g.:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=

# Backend server port (the Vite dev server proxies /api requests here).
PORT=5174

# Max upload size for a single .docx, in megabytes.
MAX_UPLOAD_MB=20

# How many LibreOffice conversions may run at once. Each is a heavyweight
# process — keep this low unless the host has real headroom.
CONVERSION_CONCURRENCY=2

# Kill a conversion that hasn't finished after this many milliseconds.
# This is the FLOOR for PDF->Word specifically — that route scales the
# actual timeout up per page (see below) so long documents (e.g. a full
# book) aren't cut off; this value is only the minimum/fallback.
CONVERSION_TIMEOUT_MS=120000

# PDF->Word only: extra milliseconds allowed per page on top of the base
# CONVERSION_TIMEOUT_MS above, since LibreOffice's PDF-import reconstruction
# (floating text boxes per line) gets slower per page than a flat export.
CONVERSION_TIMEOUT_PER_PAGE_MS=3000

# PDF->Word only: hard ceiling on the scaled timeout, regardless of page
# count, so a pathological/corrupt file can't hang a worker forever.
CONVERSION_TIMEOUT_MAX_MS=900000

# Cap on how many likely-scanned pages get OCR'd per PDF (OCR is slow).
OCR_MAX_PAGES=30

# --- Equation recovery (optional) ---
# Detects flattened equation images in PDF->Word output and replaces them
# with real editable Word equations, via a local pix2tex (LaTeX-OCR) Python
# service. Entirely optional — everything else works with this left unset.
# Set to "false" to explicitly disable (skips even the one-time startup
# attempt on the first PDF->Word request that contains a detected equation).
MATH_OCR_ENABLED=true

# Override the python executable used to launch the pix2tex server. Leave
# unset to use server/python/venv (see README "Equation recovery") or fall
# back to python3/python on PATH.
MATH_OCR_PYTHON_PATH=

# Local port the pix2tex FastAPI server listens on.
MATH_OCR_PORT=5185

# How long to wait for the pix2tex model to finish loading on first use
# (model load is slow — several seconds to over a minute on CPU).
MATH_OCR_STARTUP_TIMEOUT_MS=300000

# Per-equation recognition request timeout.
MATH_OCR_REQUEST_TIMEOUT_MS=20000
