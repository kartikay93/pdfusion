{
  "name": "pdfusion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:full": "concurrently -n server,vite -c green,cyan \"npm:server\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test:server": "node --test server/test/regression.test.js server/test/equationRecovery.test.js server/test/fidelityCheck.test.js",
    "compare": "node server/scripts/compareFidelity.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.22.0",
    "@napi-rs/canvas": "^0.1.100",
    "@xmldom/xmldom": "^0.9.12",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.383.0",
    "mammoth": "^1.8.0",
    "mathjax-full": "^3.2.1",
    "mathml2omml": "^0.5.0",
    "multer": "^2.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.6.82",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
